# SprintIQ Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ==========================================
# Supabase Configuration
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# AI Services
# ==========================================
# Claude API (Anthropic) - Primary AI for story generation
# Get your API key at: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-your_anthropic_api_key_here
# Alternative key name (some integrations use this)
# ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here

# Deepseek API (Fallback) - Used when Claude is unavailable
# Get your API key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Voyage AI (used for embeddings and vector search)
# Get your API key at: https://dash.voyageai.com/
VOYAGE_API_KEY=pa-your_voyage_api_key_here

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
SPRINTIQ_MCP_URL=http://localhost:3000/api/mcp/server

# ==========================================
# Security
# ==========================================
# Encryption key for storing sensitive tokens (32 bytes, hex-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# ==========================================
# Redis / Upstash (Rate Limiting & Caching)
# ==========================================
# REQUIRED for production rate limiting across serverless instances
# Without Redis, rate limiting falls back to in-memory (per-instance, not shared)
# Get your credentials at: https://console.upstash.com/
# Alternative: Use Vercel KV (Redis-compatible)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ==========================================
# QStash (Message Queue — @upstash/qstash SDK)
# ==========================================
# Manages async AI task processing via Upstash QStash
# Get your credentials at: https://console.upstash.com/qstash
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# ==========================================
# Optional Services
# ==========================================
# Add any additional API keys or secrets here
# MCP_RATE_LIMIT=100
# MCP_CORS_ORIGINS=*
