#!/bin/sh

echo "🔍 Checking for ID type mismatch patterns..."

# Check for dangerous .or() patterns with space_id in database queries
# Specifically look for .or() followed by template literal with space_id.eq patterns
if grep -rn "\.or(\s*\`.*space_id\.eq.*space_id\.eq" --include="*.ts" --include="*.tsx" app/ components/ lib/ 2>/dev/null; then
  echo "❌ ERROR: Found .or() with multiple space_id comparisons in database query"
  echo "   Foreign key columns (space_id) must use UUID only"
  echo "   Use: .eq('space_id', space.id)"
  echo "   NOT: .or(\`space_id.eq.\${space.id},space_id.eq.\${space.space_id}\`)"
  exit 1
fi

# Check for dangerous .or() patterns with project_id in database queries
if grep -rn "\.or(\s*\`.*project_id\.eq.*project_id\.eq" --include="*.ts" --include="*.tsx" app/ components/ lib/ 2>/dev/null; then
  echo "❌ ERROR: Found .or() with multiple project_id comparisons in database query"
  echo "   Foreign key columns (project_id) must use UUID only"
  echo "   Use: .eq('project_id', project.id)"
  exit 1
fi

echo "✅ ID type check passed"

echo "🔍 Checking for SELECT * queries..."

# Warn about .select('*') or .select("*") patterns in new/modified files
# This is a warning, not a blocker, as there may be legitimate exceptions
SELECT_STAR_COUNT=$(git diff --cached --name-only --diff-filter=ACM | xargs grep -l "\.select(['\"]\\*['\"])" 2>/dev/null | wc -l)
if [ "$SELECT_STAR_COUNT" -gt 0 ]; then
  echo "⚠️  WARNING: Found .select('*') patterns in staged files:"
  git diff --cached --name-only --diff-filter=ACM | xargs grep -l "\.select(['\"]\\*['\"])" 2>/dev/null
  echo ""
  echo "   Consider using explicit column lists from @/lib/query-columns.ts"
  echo "   Example: .select(WORKSPACE_COLUMNS.CORE) instead of .select('*')"
  echo "   See docs/SELECT_STAR_EXCEPTIONS.md for legitimate exceptions"
  echo ""
fi

# Check RLS policy migrations for missing DROP POLICY IF EXISTS
if git diff --cached --name-only --diff-filter=ACM | grep -q "^supabase/migrations/.*\.sql$"; then
  echo "🔍 Checking RLS policy migrations..."
  bash scripts/check-rls-migrations.sh
  if [ $? -ne 0 ]; then
    exit 1
  fi
fi

